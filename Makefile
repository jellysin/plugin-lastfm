	@exec './tools/sdk.sh' 'dotnet' 'build' './benchmarks/JellySin.Plugin.Lastfm.Benchmarks/JellySin.Plugin.Lastfm.Benchmarks.csproj' '-c' 'Release' '--no-restore' '-warnaserror'
	@exec './tools/sdk.sh' 'dotnet' 'restore' './src/JellySin.Plugin.Lastfm/JellySin.Plugin.Lastfm.csproj' '--locked-mode'
	@exec './tools/sdk.sh' 'dotnet' 'build' './src/JellySin.Plugin.Lastfm/JellySin.Plugin.Lastfm.csproj' '-c' 'Release' '--no-restore' '-warnaserror'
	@exec './tools/sdk.sh' 'dotnet' 'restore' './tests/JellySin.Plugin.Lastfm.Tests/JellySin.Plugin.Lastfm.Tests.csproj' '--locked-mode'
	@exec './tools/sdk.sh' 'dotnet' 'build' './tests/JellySin.Plugin.Lastfm.Tests/JellySin.Plugin.Lastfm.Tests.csproj' '-c' 'Release' '--no-restore' '-warnaserror'
	@exec './tools/sdk.sh' 'dotnet' 'restore' './tests/integration/JellySin.NativeProbe/JellySin.NativeProbe.csproj' '--locked-mode'
