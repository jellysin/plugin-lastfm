{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "rangeStrategy": "pin",
  "automerge": false,
  "prConcurrentLimit": 10,
  "labels": ["dependencies"],
  "vulnerabilityAlerts": {"enabled": true, "minimumReleaseAge": null},
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^runtime-dependencies\\.json$/"],
      "matchStrings": ["\"id\":\\s*\"(?<depName>[^\"]+)\",\\s*\"version\":\\s*\"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "nuget",
      "versioningTemplate": "nuget"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^tools/smoke\\.py$/"],
      "matchStrings": ["\"(?<depType>floor|newest|[0-9]+\\.[0-9]+)\":\\s*\"jellyfin/jellyfin:(?<currentValue>[0-9]+\\.[0-9]+(?:\\.[0-9]+)?)@(?<currentDigest>sha256:[a-f0-9]{64})\""],
      "depNameTemplate": "jellyfin/jellyfin",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {"matchManagers": ["github-actions"], "groupName": "GitHub Actions"},
    {"matchUpdateTypes": ["major"], "groupName": null},
    {"matchPackageNames": ["/^Jellyfin\\./", "jellyfin/jellyfin"], "allowedVersions": "/^12(?:\\.|$)/", "groupName": "Jellyfin 12"},
    {
      "description": "The plugin compiles against the oldest supported Jellyfin (targetAbi in plugin.json); a newer reference does not load there. See CONTRIBUTING.",
      "matchDatasources": ["nuget"],
      "matchPackageNames": ["/^Jellyfin\\./"],
      "enabled": false
    },
    {
      "description": "The floor server image keeps the release named by targetAbi in plugin.json; only its digest moves. tools/abi_floor.py compares this pattern with the descriptor.",
      "matchPackageNames": ["jellyfin/jellyfin"],
      "matchDepTypes": ["floor"],
      "allowedVersions": "/^12\\.0(?:\\.|$)/"
    },
    {
      "description": "A server image named after a release in tools/smoke.py keeps that release; only its digest moves. The Python tests compare this pattern with the entry.",
      "matchPackageNames": ["jellyfin/jellyfin"],
      "matchDepTypes": ["12.1"],
      "allowedVersions": "/^12\\.1(?:\\.|$)/"
    }
  ]
}
