{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>plurano/horistes",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": true,
  "rangeStrategy": "pin",
  "prConcurrentLimit": 5,
  "labels": [
    "dependencies"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^runtime-dependencies\\.json$/"
      ],
      "matchStrings": [
        "\"id\":\\s*\"(?<depName>[^\"]+)\",\\s*\"version\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "nuget",
      "versioningTemplate": "nuget"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tools/smoke\\.py$/"
      ],
      "matchStrings": [
        "\"(?<depType>floor|newest|[0-9]+\\.[0-9]+)\":\\s*\"jellyfin/jellyfin:(?<currentValue>[0-9]+\\.[0-9]+(?:\\.[0-9]+)?)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "depNameTemplate": "jellyfin/jellyfin",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tools/JellySin\\.CodePolicy/README\\.md$/"
      ],
      "matchStrings": [
        "https://github\\.com/SonarSource/sonar-dotnet/releases/tag/(?<currentValue>[0-9]+(?:\\.[0-9]+){3})"
      ],
      "depNameTemplate": "SonarAnalyzer.CSharp",
      "datasourceTemplate": "nuget",
      "versioningTemplate": "nuget"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tools/sdk\\.sh$/"
      ],
      "matchStrings": [
        "_IMAGE=\"(?<depName>mcr\\.microsoft\\.com/dotnet/sdk|node):(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "The release-helper checkouts for independent rebuilds pin the commit the release-helper actions use; github-actions reads only the uses: lines.",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "repository: jellysin/release-helper\\s+ref: (?<currentDigest>[a-f0-9]{40}) # (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "jellysin/release-helper",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "The release-helper checkout refs move in the same pull request as the release-helper actions. tests/python/test_release_helper_pin.py compares them.",
      "matchPackageNames": [
        "jellysin/release-helper"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "The code policy README links the analyzer release its project file pins; one pull request moves both. The Python tests compare the two.",
      "matchPackageNames": [
        "SonarAnalyzer.CSharp"
      ],
      "groupName": "SonarAnalyzer.CSharp"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null
    },
    {
      "matchPackageNames": [
        "/^Jellyfin\\./",
        "jellyfin/jellyfin"
      ],
      "allowedVersions": "/^12(?:\\.|$)/",
      "groupName": "Jellyfin 12"
    },
    {
      "description": "The plugin compiles against the oldest supported Jellyfin (targetAbi in plugin.json); a newer reference does not load there. See CONTRIBUTING.",
      "matchDatasources": [
        "nuget"
      ],
      "matchPackageNames": [
        "/^Jellyfin\\./"
      ],
      "enabled": false
    },
    {
      "description": "The floor server image keeps the release named by targetAbi in plugin.json; only its digest moves. tools/abi_floor.py compares this pattern with the descriptor.",
      "matchPackageNames": [
        "jellyfin/jellyfin"
      ],
      "matchDepTypes": [
        "floor"
      ],
      "allowedVersions": "/^12\\.0(?:\\.|$)/"
    },
    {
      "description": "A server image named after a release in tools/smoke.py keeps that release; only its digest moves. The Python tests compare this pattern with the entry.",
      "matchPackageNames": [
        "jellyfin/jellyfin"
      ],
      "matchDepTypes": [
        "12.1"
      ],
      "allowedVersions": "/^12\\.1(?:\\.|$)/"
    },
    {
      "description": "A server image named after a release in tools/smoke.py keeps that release; only its digest moves. The Python tests compare this pattern with the entry.",
      "matchPackageNames": [
        "jellyfin/jellyfin"
      ],
      "matchDepTypes": [
        "12.2"
      ],
      "allowedVersions": "/^12\\.2(?:\\.|$)/"
    },
    {
      "description": "praetor-managed files: praetorctl adopt ships their updates and praetorctl audit locks them byte for byte",
      "matchFileNames": [
        ".devcontainer/devcontainer.json",
        ".devcontainer/Dockerfile.praetor",
        ".github/workflows/reuse.yml"
      ],
      "enabled": false
    },
    {
      "description": "The local gate's SDK containers in tools/sdk.sh carry the versions of global.json and .node-version; one pull request moves all three. tests/python/test_sdk_pin.py compares them.",
      "matchFileNames": [
        "global.json",
        ".node-version",
        "tools/sdk.sh"
      ],
      "groupName": "SDK toolchain"
    },
    {
      "description": "The registries return no release time for the SDK images, so the three-day wait would hold them forever and global.json and .node-version would move alone. The images follow the version files, which still wait.",
      "matchFileNames": [
        "tools/sdk.sh"
      ],
      "matchDatasources": [
        "docker"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ]
}
