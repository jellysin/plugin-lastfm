<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>JellySin.Plugin.Lastfm</RootNamespace>
    <AssemblyName>JellySin.Plugin.Lastfm</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <EmbeddedResource Include="Web/**/*" />
    <Content Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(LASTFM_API_KEY)' != ''">
      <_Parameter1>JellySinLastfmApiKey</_Parameter1>
      <_Parameter2>$(LASTFM_API_KEY)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(LASTFM_SHARED_SECRET)' != ''">
      <_Parameter1>JellySinLastfmSharedSecret</_Parameter1>
      <_Parameter2>$(LASTFM_SHARED_SECRET)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
